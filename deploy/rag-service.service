[Unit]
Description=RAG Anything Knowledge & FastMCP Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/PyCharmMiscProject/rag-anything-use
EnvironmentFile=/home/ubuntu/PyCharmMiscProject/rag-anything-use/.env
ExecStart=/home/ubuntu/PyCharmMiscProject/rag-anything-use/.venv/bin/python src/mcp_server.py

# 崩溃秒级自愈
Restart=always
RestartSec=5s

# 优雅停止信号处理，预留30秒供任务清理和锁释放
KillMode=mixed
TimeoutStopSec=30
LimitNOFILE=65535

# 日志输出至 systemd journal (journalctl -u rag-service -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
