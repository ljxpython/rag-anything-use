# 示例运行配置
PARSER=docling
PARSE_METHOD=auto
WORKING_DIR=./rag_storage
OUTPUT_DIR=./output
TEST_DOCUMENT_PATH=./test_data/接口文档.pdf
TEST_IMAGE_PATH=./test_data/11a1f536fbf8a56a69ffa6b298b2408d.jpeg

# 文本查询无需 TEST_* / VISION_*；examples 单独需要它们。
# 当前已验证组合：miaomiaoai DeepSeek（文本和视觉）
# 文本推理模型配置
LLM_BASE_URL=https://your-private-provider/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MAX_TOKENS=8192
# DeepSeek 抽取关闭思考，避免只返回 reasoning 而没有正文；其它供应商可设 {}。
LLM_EXTRA_BODY_JSON='{"thinking":{"type":"disabled"},"reasoning_effort":"off"}'

# 视觉模型配置：填写与上方 LLM 相同的端点、模型和私有密钥。
VISION_BASE_URL=https://your-private-provider/v1
VISION_MODEL=deepseek-v4.1-flash
VISION_API_KEY=replace-with-your-vision-api-key
VISION_MAX_TOKENS=8192

# 嵌入模型配置
EMBEDDING_PROVIDER=ollama
# 外部兼容 API：provider=openai，base_url 填兼容接口根地址，配置 API_KEY。
# 例如百炼 text-embedding-v4，可设 EMBEDDING_DIM=1024。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_MAX_TOKENS=8192

# Knowledge 服务默认配置
KNOWLEDGE_ROOT_DIR=./knowledge_data
KNOWLEDGE_QUERY_MODE=hybrid
KNOWLEDGE_TOP_K=8
KNOWLEDGE_INCLUDE_CITATIONS=true

# 项目逻辑库在线入库：默认关闭。只读 legacy scope 不需要下列授权配置。
KNOWLEDGE_ONLINE_ENABLED=false
# 专用平台授权端点与 HMAC key（不得复用 JWT、MCP Bearer 或其它 callback secret）。
KNOWLEDGE_AUTHORIZE_URL=
KNOWLEDGE_AUTHORIZATION_KEY_ID=
KNOWLEDGE_AUTHORIZATION_SECRET=
# 本地磁盘额度覆盖原件、暂存、成果、候选、历史索引和读副本；达到即拒绝新增。
KNOWLEDGE_MAX_PROJECT_DISK_BYTES=2147483648
KNOWLEDGE_MAX_DISK_BYTES=10737418240
# online scope 用 knowledge_base_id 替代 namespace，两者只能填一个。
# 注册后由管理员核对迁移/配置并显式开启该项目上传；全局开关单独控制。
# KNOWLEDGE_MCP_TOKEN_SCOPES_JSON={"replace-with-a-random-token-at-least-32-characters":{"tenant_id":"__default","project_id":"11111111-1111-4111-8111-111111111111","knowledge_base_id":"kb_0123456789abcdef0123456789abcdef"}}

# MCP server 启动配置
# 默认 Streamable HTTP + Bearer 固定项目范围；随机 token 至少32字符。
KNOWLEDGE_MCP_TOKEN_SCOPES_JSON={"replace-with-a-random-token-at-least-32-characters":{"tenant_id":"__default","project_id":"11111111-1111-4111-8111-111111111111","namespace":"project_a_v1"}}
# stdio 管理员模式另外设置有效 KNOWLEDGE_STDIO_TOKEN。
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_SHOW_BANNER=false
# MCP_LOG_LEVEL=INFO

# 知识库 ingestion 稳态模式
# 为了保证联调阶段“真实可跑通”，默认关闭多模态增强。
# 如需实验图片/表格/公式增强，可改为 true；完整文档链仍需单独验收。
KNOWLEDGE_ENABLE_IMAGE_PROCESSING=false
KNOWLEDGE_ENABLE_TABLE_PROCESSING=false
KNOWLEDGE_ENABLE_EQUATION_PROCESSING=false

# examples 兼容开关
# 如果不单独设置，代码会回退读取 KNOWLEDGE_ENABLE_* 配置。
# 这里显式写出来，避免别人复制 env.example 后误以为 examples 默认开启多模态增强。
ENABLE_IMAGE_PROCESSING=false
ENABLE_TABLE_PROCESSING=false
ENABLE_EQUATION_PROCESSING=false

# Milvus 预留配置
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_NAME=llm_collection

# 已预下载完整 Docling/Hugging Face 模型时可开启，避免每个解析进程联网检查。
# HF_HUB_OFFLINE=1
# HF_HUB_DISABLE_TELEMETRY=1
